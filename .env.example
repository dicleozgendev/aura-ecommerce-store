# Copy this file to .env and fill in real values for local development.
# On Vercel, set these under Project -> Settings -> Environment Variables
# instead (do not commit real secrets).

# Plain username for the admin login.
ADMIN_USERNAME=admin

# bcrypt HASH of the admin password -- never store the plaintext password
# here. Generate one locally with Node:
#   node -e "console.log(require('bcryptjs').hashSync('your-password-here', 12))"
ADMIN_PASSWORD_HASH=

# Long random string used to sign admin session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=
